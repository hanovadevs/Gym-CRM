{
  "name": "gymcrm",
  "version": "0.1.0",
  "description": "Jym CRM local PostgreSQL foundation",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "node tests/integration/database.mjs && tsx tests/integration/auth-schema.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:production": "node tests/integration/production.mjs",
    "auth:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "test:auth": "tsx tests/integration/auth-lifecycle.ts",
    "test:security": "node --conditions=react-server --import tsx tests/integration/security.ts",
    "test:settings": "node --conditions=react-server --import tsx tests/integration/settings.ts",
    "test:members": "node --conditions=react-server --import tsx tests/integration/members.ts",
    "test:profiles": "node --conditions=react-server --import tsx tests/integration/profiles.ts",
    "test:mail": "node --conditions=react-server --import tsx tests/integration/mail.ts",
    "test:plans": "node --conditions=react-server --import tsx tests/integration/plans.ts",
    "mail:deliver": "node --conditions=react-server --import tsx scripts/deliver-mail.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.27",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
